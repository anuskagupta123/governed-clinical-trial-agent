      "field": "labs.hba1c",
      "operator": "between",
      "value": [
        6.5,
        9.0
      ],
      "unit": "%",
      "source": "protocol",
      "citation": "Page 1, Inclusion Criteria 3",
      "criterion_type": "inclusion"
    },
    {
