{
  "trial_id": "SYN-DM-001",
  "trial_name": "A Synthetic Phase II Study of an Investigational Therapy in Adults With Type 2 Diabetes",
  "inclusion_criteria": [
    {
      "id": "INC-1",
      "description": "Participant must be 18 to 65 years old, inclusive.",
      "field": "age",
      "operator": "between",
