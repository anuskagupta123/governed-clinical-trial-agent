        18.0,
        65.0
      ],
      "unit": "years",
      "source": "protocol",
      "citation": "Page 1, Inclusion Criteria 1",
      "criterion_type": "inclusion"
    },
    {
      "id": "INC-2",
      "description": "Estimated glomerular filtration rate (eGFR) must be greater than 60 mL/min/1.73m\u00b2.",
      "field": "labs.egfr",
